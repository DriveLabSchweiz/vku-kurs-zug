---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import vkuData from "../../../data/vku_data_en.json";
import OptimizedImage from "../../../components/OptimizedImage.astro";

const { course, locations } = vkuData;
const currentLocation = locations[2];
const otherLocations = locations.filter((l) => l.slug !== "steinhausen");
---

<BaseLayout
  title="VKU from Steinhausen – getting to class"
  description="Your destination is Industriestrasse 50 in Zug. Plan your trip by train, bus or car and choose your course dates."
  canonical="https://vku-kurs-zug.ch/en/ort/steinhausen"
  lang="en"
>
  <!-- Hero Section -->
  <section class="bg-gradient-to-r from-blue-600 to-blue-800 text-white py-12">
    <div class="max-w-6xl mx-auto px-4">
      <h1 class="text-4xl font-bold mb-4">VKU from Steinhausen – getting to class</h1><p class="text-xl">Your destination is Industriestrasse 50 in Zug.</p>
    </div>
  </section>

  <!-- Breadcrumb -->
  <nav class="bg-gray-50 py-4">
    <div class="max-w-6xl mx-auto px-4">
      <a href="/en/" class="text-blue-600 hover:underline">Home</a> >
      <a href="/en/#standorte" class="text-blue-600 hover:underline"
        >Locations</a
      > >
      <span class="text-gray-600">Steinhausen</span>
    </div>
  </nav>

  <!-- Main Content -->
  <section class="py-12 max-w-6xl mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
      <div>
        <OptimizedImage
          src="/vku-klassenzimmer-u-form.webp"
          alt="Classroom in Zug"
          width={600}
          height={400}
          class="rounded-lg shadow-lg mb-6 w-full object-cover"
          loading="eager"
        />
        <h2 class="text-3xl font-bold mb-4">From Steinhausen to the classroom</h2><p class="mb-4">Travel from Steinhausen station to Zug. Allow about nine minutes to walk to the classroom, plus time to find the entrance.</p>
       <h3 class="text-xl font-bold">By bus</h3><p class="mb-4">Compare services from your stop to Zug, Göbli and to Zug station. A different return route may suit a late finish.</p>
       <h3 class="text-xl font-bold">By car or motorcycle</h3><p class="mb-4">The GIBZ car park is opposite the venue. Drinks, fruit and course materials are provided in class.</p>
       <h3 class="text-xl font-bold">Address and timetable</h3><p>Industriestrasse 50, 6300 Zug</p>
       <p class="inline-links mb-6"><a href="https://www.sbb.ch/en">Check SBB connections</a></p>
       <a
          href="/en/course-dates"
          class="bg-blue-600 text-white px-8 py-3 rounded font-bold hover:bg-blue-700 inline-block"
        >
          Register Now
        </a>
      </div>

      <div>
        <div class="bg-blue-50 p-8 rounded-lg">
          <h3 class="text-2xl font-bold mb-6">Course Information</h3>
          <div class="space-y-4">
            <div class="border-b pb-4">
              <p class="font-semibold text-gray-600">Price</p>
              <p class="text-2xl font-bold text-blue-600">{course.price}</p>
              <p class="text-sm text-gray-600">
                Incl. material, certificate, drinks, fruit
              </p>
            </div>
            <div class="border-b pb-4">
              <p class="font-semibold text-gray-600">Duration</p>
              <p class="text-2xl font-bold text-blue-600">{course.duration}</p>
              <p class="text-sm text-gray-600">{course.duration_days}</p>
            </div>
            <div class="border-b pb-4">
              <p class="font-semibold text-gray-600">Modules</p>
              <p class="text-2xl font-bold text-blue-600">4</p>
              <p class="text-sm text-gray-600">
                Traffic vision, environment, dynamics, tactics
              </p>
            </div>
            <div>
              <p class="font-semibold text-gray-600">Location</p>
              <p class="text-2xl font-bold text-blue-600">Central</p>
              <p class="text-sm text-gray-600">Easily accessible</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Weitere Standorte -->
    <div class="mt-12">
      <h2 class="text-3xl font-bold mb-8">Other routes to the classroom</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {
          otherLocations.map((location) => (
            <div class="border rounded-lg p-6 hover:shadow-lg transition">
              <h3 class="text-xl font-bold mb-3">{location.name}</h3>
              <p class="text-gray-700 mb-4">{location.description}</p>
              <a
                href={`/en/ort/${location.slug}`}
                class="text-blue-600 hover:underline font-semibold"
              >
                Learn more →
              </a>
            </div>
          ))
        }
      </div>
    </div>

    <!-- CTA -->
    <div class="mt-12 text-center">
      <a
        href="/en/"
        class="bg-blue-600 text-white px-8 py-3 rounded font-bold hover:bg-blue-700 inline-block"
        >Back to Home</a
      >
    </div>
  </section>

  <!-- Breadcrumb Schema -->
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://vku-kurs-zug.ch/en/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Locations",
          item: "https://vku-kurs-zug.ch/en/#standorte",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Steinhausen",
          item: "https://vku-kurs-zug.ch/en/ort/steinhausen",
        },
      ],
    })}
  />
</BaseLayout>
