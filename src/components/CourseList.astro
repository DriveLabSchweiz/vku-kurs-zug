---
import { getCourses, bookingLink, provider, type Language } from '../lib/amelia';
const {lang = 'de', filters = false} = Astro.props as {lang?:Language;filters?:boolean};
const en = lang === 'en';
const path = en ? '/en/course-dates' : '/kurstermine';
const periods = en ? ['All times','Evenings only','Includes a weekend'] : ['Alle Zeiten','Nur Abendkurse','Mit Wochenende'];
const windows = ['all','evening','weekend'];
const selected = filters && windows.includes(Astro.url.searchParams.get('zeit') ?? '') ? Astro.url.searchParams.get('zeit')! : 'all';
const requestedLang = filters ? Astro.url.searchParams.get('sprache') : null;
const language = ['de','en','all'].includes(requestedLang ?? '') ? requestedLang : en ? 'en' : 'all';
const data = await getCourses();
const courses = (data ?? []).filter(c => (language==='all'||c.language===language) && (selected==='all'||(selected==='evening'?c.evening:c.weekend)));
const date = (day:string) => new Intl.DateTimeFormat(en?'en-GB':'de-CH',{weekday:'long',month:'long',day:'numeric',year:'numeric',timeZone:'UTC'}).format(new Date(day+'T12:00:00Z'));
const other = en ? '/en/course-dates?sprache=all' : '/kurstermine?sprache=all';
---
{filters && <form class="course-filter" method="get" action={path}>
 <label>{en?'When can you attend?':'Wann hast du Zeit?'}<select name="zeit">{windows.map((v,i)=><option value={v} selected={v===selected}>{periods[i]}</option>)}</select></label>
 <label>{en?'Teaching language':'Kurssprache'}<select name="sprache">{['all','de','en'].map((v,i)=><option value={v} selected={v===language}>{(en?['All languages','German','English']:['Alle Sprachen','Deutsch','Englisch'])[i]}</option>)}</select></label>
 <button class="action" type="submit">{en?'Show courses':'Kurse anzeigen'}</button>
</form>}
{courses.map(c=><article class="course-card">
 <div class="course-head"><p class="overline">{en?'Course in '+(c.language==='de'?'German':'English'):'Kurs auf '+(c.language==='de'?'Deutsch':'Englisch')}</p><strong>CHF {c.price}</strong></div>
 <h3>{c.evening?(en?'Evening course in Zug':'Abendkurs in Zug'):(en?'VKU in Zug':'Verkehrskunde in Zug')}</h3>
 <ul class="session-list">{c.sessions.map(s=><li><time datetime={s.day}>{date(s.day)}</time><b>{s.start} – {s.end}</b></li>)}</ul>
 <p>Industriestrasse 50, 6300 Zug{c.organizer && <><br />{en?'Course provider':'Kursanbieter'} · {c.organizer}</>}</p>
 <a class="action" href={bookingLink(c,lang)}>{en?'Book this group at DriveLab':'Diesen Kurs bei DriveLab buchen'} <span aria-hidden="true">↗</span></a>
</article>)}
{!courses.length && <div class="course-card empty"><h3>{data===null?(en?'Check dates with DriveLab':'Termine direkt bei DriveLab prüfen'):en?'No matching course in Zug':'Kein passender Kurs in Zug'}</h3>
 <p>{data===null?(en?'The live schedule is temporarily unavailable. The official list shows the current options.':'Der Kursplan lässt sich momentan nicht laden. Die aktuelle Auswahl findest du in der offiziellen Anmeldung.'):en?'There is currently no bookable Zug group for this selection. You can check other times or compare English courses at Zurich HB.':'Für diese Auswahl ist zurzeit keine vollständige Zuger Gruppe buchbar. Prüfe andere Zeitfenster oder die nächsten Ausschreibungen bei DriveLab.'}</p>
 <div class="inline-links"><a href={other}>{en?'All Zug dates':'Alle Zuger Termine'}</a><a href={provider}>{en?'DriveLab schedule':'Angebot bei DriveLab'}</a>{en && <a href="https://english-vku-zurich.ch/">English courses in Zurich</a>}</div>
</div>}
