{
  "name": "vku-kurs-zug",
  "compatibility_date": "2025-11-22",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "0f5ef05aeee843799888862a4a83f980"
    }
  ],
  "observability": {
    "enabled": true
  },
  "main": "./src/worker.ts",
  "routes": [
    {
      "pattern": "vku-kurs-zug.ch",
      "custom_domain": true
    },
    {
      "pattern": "www.vku-kurs-zug.ch",
      "custom_domain": true
    }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "dev": {
    "host": "localhost"
  }
}
